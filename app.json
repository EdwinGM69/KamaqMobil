{
  "expo": {
    "name": "Kamaq Mobile",
    "slug": "kamaq-mobile",
    "version": "1.0.0",
    "scheme": "kamaq",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F4C81"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kamaq.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F4C81"
      },
      "package": "com.kamaq.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Kamaq Mobile necesita acceso a la camara para escanear codigos de barras.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-asset",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
